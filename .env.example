NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/zorvyn

# At least 16 characters. Use long random values in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# OpenAI-compatible chat completions endpoint.
# Leave LLM_API_KEY empty to use the built-in keyword categorizer.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=12000

CORS_ORIGIN=*

# Used by `npm run seed` to create the first administrator.
SEED_ADMIN_NAME=Zorvyn Admin
SEED_ADMIN_EMAIL=admin@zorvyn.local
SEED_ADMIN_PASSWORD=ChangeMe123
